#!/bin/sh
# Keep each plugin's version in step with its content (scripts/stamp-versions.py).
# Enable once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 0
python3 "$root/scripts/stamp-versions.py" || exit 0
git -C "$root" diff --name-only -- 'plugins/*/.claude-plugin/plugin.json' | while IFS= read -r f; do
  git -C "$root" add -- "$f"
done
exit 0
