# The host CLIs the blocking lanes install: plugin-smoke.yml (which ci.yml and
# marketplace-canary.yml call) reads them, and nothing else pins them. The
# advisory plugins-latest.yml passes "latest" instead. One KEY=value a line,
# appended as is to $GITHUB_ENV. The mods' engines are not here: the mod and
# mod-ktn jobs read their floor from targets.claude.minimumVersion of
# plugins/kodflow-hud and plugins/kodflow-ktn.
CLAUDE_CODE_VERSION=2.1.325
CODEX_VERSION=0.170.0
