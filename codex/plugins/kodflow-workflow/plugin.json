{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kodflow-workflow",
  "version": "0.0.0-rc90bf358d399",
  "description": "The work loop: open a tracked piece of work, research it, plan it, argue the plan, turn it into an executable contract, ship it. Each skill hands the next exactly what it needs, and every step leaves a trail the next session can read.",
  "author": {
    "name": "kodflow",
    "url": "https://github.com/kodflow"
  },
  "homepage": "https://github.com/kodflow/claude-marketplace",
  "repository": "https://github.com/kodflow/claude-marketplace.git",
  "license": "MIT",
  "keywords": [
    "workflow",
    "planning",
    "multi-agent"
  ],
  "extensions": {
    "io.github.kodflow": {
      "schemaVersion": 1,
      "installByDefault": true,
      "scope": "user",
      "dependencies": [
        {
          "plugin": "kodflow-specialists",
          "required": false
        }
      ],
      "capabilities": {
        "skills": "required",
        "multi-agent": "optional"
      },
      "targets": {
        "claude": {
          "enabled": true,
          "profile": "native"
        },
        "openai": {
          "enabled": true,
          "profile": "generated"
        },
        "perplexity": {
          "enabled": true,
          "profile": "portable"
        }
      }
    }
  }
}
