{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodflow/claude-marketplace/schemas/compatibility-report-v1.schema.json",
  "title": "Kodflow target compatibility report",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugin": { "type": "string" },
    "target": { "enum": ["claude", "openai", "perplexity"] },
    "enabled": { "type": "boolean" },
    "compatible": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "policy": { "enum": ["required", "optional"] },
          "status": { "enum": ["equivalent", "advisory-loss", "absent"] },
          "origin": { "enum": ["native", "generated", "none"] },
          "verifierId": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        },
        "required": ["name", "policy", "status", "origin", "verifierId", "reason"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "equivalent" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "verifierId": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["schemaVersion", "plugin", "target", "enabled", "compatible", "capabilities"],
  "additionalProperties": false
}
