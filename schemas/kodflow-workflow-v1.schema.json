{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodflow/claude-marketplace/schemas/kodflow-workflow-v1.schema.json",
  "title": "Kodflow workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "description", "inputSchema", "tasks"],
  "properties": {
    "apiVersion": { "const": "io.github.kodflow/workflow/v1" },
    "id": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "minLength": 1 },
    "inputSchema": { "type": "object" },
    "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
      "uniqueItems": true
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "instructions", "inputSchema", "outputSchema"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "provider": { "$ref": "#/$defs/id" },
        "instructions": { "type": "string", "minLength": 1 },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "with": { "type": "object" },
        "access": { "enum": ["read", "write"] },
        "ownedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "approval": { "type": "boolean" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "compensation": { "type": "string", "minLength": 1 },
        "requiredCapabilities": { "$ref": "#/$defs/capabilities" }
      }
    }
  }
}
