{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kodflow/claude-marketplace/schemas/kodflow-catalog-v1.schema.json",
  "title": "Kodflow canonical plugin catalog",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "repository": { "type": "string" },
    "owner": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["name", "url"],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string", "pattern": "^plugins/[a-z0-9.-]+$" },
          "description": { "type": "string" },
          "category": { "type": "string" }
        },
        "required": ["name", "path", "description", "category"],
        "additionalProperties": false
      }
    }
  },
  "required": ["$schema", "schemaVersion", "name", "description", "repository", "owner", "plugins"],
  "additionalProperties": false
}
