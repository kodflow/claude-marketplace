{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kodflow-specialists",
  "version": "0.0.0-r1545a2d71e00",
  "description": "Language, platform and concern specialists that routing dispatches to. Each verifies an API, a default, a limit or a deprecation against documentation before asserting it, returns what it consulted and what it could not confirm, and tries to break its own finding before reporting it.",
  "author": {
    "name": "kodflow",
    "url": "https://github.com/kodflow"
  },
  "homepage": "https://github.com/kodflow/claude-marketplace",
  "repository": "https://github.com/kodflow/claude-marketplace.git",
  "license": "MIT",
  "keywords": [
    "agents",
    "specialists",
    "multi-agent"
  ],
  "extensions": {
    "io.github.kodflow": {
      "schemaVersion": 1,
      "installByDefault": true,
      "scope": "user",
      "dependencies": [],
      "capabilities": {
        "agents": "required"
      },
      "targets": {
        "claude": {
          "enabled": true,
          "profile": "native"
        },
        "openai": {
          "enabled": false,
          "profile": "legacy-flat-only"
        },
        "perplexity": {
          "enabled": false,
          "profile": "disabled"
        }
      }
    }
  }
}
