{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "developer-executor-security result",
  "description": "The role instructions specify the applicable report format for the current host and mode.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "agent",
        "issues",
        "commendations",
        "metrics"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object"
        },
        "summary": {
          "type": "string"
        },
        "agent_feedback": {
          "type": "string"
        }
      }
    },
    {
      "type": "string",
      "minLength": 1
    }
  ]
}
