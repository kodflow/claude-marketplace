{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kodflow-shell",
  "version": "0.0.0-r0aca37f5a791",
  "description": "Shell integration, session selection, and local housekeeping.",
  "author": {
    "name": "kodflow",
    "url": "https://github.com/kodflow"
  },
  "homepage": "https://github.com/kodflow/claude-marketplace",
  "repository": "https://github.com/kodflow/claude-marketplace.git",
  "license": "MIT",
  "keywords": [
    "shell",
    "sessions",
    "zsh"
  ],
  "extensions": {
    "io.github.kodflow": {
      "schemaVersion": 1,
      "installByDefault": true,
      "scope": "user",
      "dependencies": [],
      "capabilities": {
        "skills": "required",
        "hooks": "optional",
        "shell-integration": "optional"
      },
      "targets": {
        "claude": {
          "enabled": true,
          "profile": "native"
        },
        "openai": {
          "enabled": true,
          "profile": "generated"
        },
        "perplexity": {
          "enabled": true,
          "profile": "portable"
        }
      }
    }
  }
}
