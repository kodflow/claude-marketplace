{
  "schema_version": "move-constraints/v1",
  "move": "synthetic-defects",
  "fps": 30,
  "rig_map": "rig-map.synthetic.json",
  "clip": "attack_cut",
  "tradition": "europe",
  "weapon": "longsword",
  "governing": "synthetic",
  "constraints": [
    {"id": "run-hand-steady", "kind": "frame_pose", "severity": "hard", "status": "proposed", "clip": "run",
     "target": "hand.R", "ref": "chest", "component": "y", "unit": "m",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: a carried sword hand stays put relative to the chest during a run",
     "test": {"stat": "peak_to_peak", "max": 0.06}},
    {"id": "run-tip-steady", "kind": "trajectory", "severity": "hard", "status": "proposed", "clip": "run",
     "point": "blade.tip", "relative_to": "chest", "metric": "path_length", "unit": "m",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the blade tip does not beat while running",
     "test": {"stat": "max", "max": 0.5}},
    {"id": "cut-edge-leads", "kind": "trajectory", "severity": "hard", "status": "proposed",
     "point": "blade.tip", "metric": "velocity_axis_angle", "unit": "deg",
     "blade_axis": {"from": "blade.base", "to": "blade.tip"},
     "window": {"from": "strike_start", "to": "strike_end"},
     "observable": {"3d": true, "iso": true, "profile": false},
     "rationale": "synthetic: in a cut the tip moves across the blade axis, in a thrust along it",
     "test": {"stat": "mean", "min": 60}},
    {"id": "cut-shoulder-lever", "kind": "reach_ratio", "severity": "hard", "status": "proposed",
     "from": "shoulder.R", "to": "hand.R", "chain": ["shoulder.R", "elbow.R", "hand.R"], "unit": "ratio",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the arm is near full extension at contact, a shoulder lever, not a wrist flick",
     "test": {"stat": "at", "at": "impact", "min": 0.85}},
    {"id": "cut-arc", "kind": "trajectory", "severity": "soft", "status": "proposed",
     "point": "blade.tip", "metric": "chord_arc_ratio", "unit": "ratio",
     "window": {"from": "strike_start", "to": "strike_end"},
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the tip travels an arc, not a straight line (guess, soft)",
     "test": {"stat": "max", "max": 0.97}},
    {"id": "grip-handedness", "kind": "handedness", "severity": "hard", "status": "proposed", "clip": "grip_hold",
     "index": "index.base.R", "pinky": "pinky.base.R", "wrist": "wrist.R", "middle": "middle.base.R",
     "palm": "palm.R", "center": "hand.center.R", "unit": "sign",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the right hand reads as a right hand",
     "test": {"stat": "all", "min": 0}},
    {"id": "grip-fingers-wrap", "kind": "grip", "severity": "hard", "status": "proposed", "clip": "grip_hold",
     "check": "fingers_wrap", "palm": "palm.R", "grip_axis": {"from": "grip.pommel", "to": "grip.guard"},
     "fingers": ["index.mid.R", "middle.mid.R", "ring.mid.R", "pinky.mid.R"], "unit": "ratio",
     "observable": {"3d": true, "iso": false, "profile": false},
     "rationale": "synthetic: the fingers close round the far side of the grip from the palm",
     "test": {"stat": "all", "min": 0.75}},
    {"id": "grip-palm-on-axis", "kind": "grip", "severity": "hard", "status": "proposed", "clip": "grip_hold",
     "check": "palm_distance", "palm": "palm.R", "grip_axis": {"from": "grip.pommel", "to": "grip.guard"}, "unit": "m",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the grip lies in the palm",
     "test": {"stat": "max", "max": 0.05}},
    {"id": "grip-index-toward-blade", "kind": "grip", "severity": "hard", "status": "proposed", "clip": "grip_hold",
     "check": "index_toward_blade", "palm": "palm.R", "grip_axis": {"from": "grip.pommel", "to": "grip.guard"},
     "index": "index.base.R", "pinky": "pinky.base.R", "unit": "sign",
     "observable": {"3d": true, "iso": true, "profile": true},
     "rationale": "synthetic: the index side of the hand faces the guard",
     "test": {"stat": "all", "min": 0}}
  ]
}
