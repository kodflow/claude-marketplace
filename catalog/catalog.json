{
  "$schema": "../schemas/kodflow-catalog-v1.schema.json",
  "schemaVersion": 1,
  "name": "kodflow",
  "description": "Portable Kodflow agent plugins with verified projections for Claude, OpenAI Codex, and Perplexity.",
  "repository": "https://github.com/kodflow/claude-marketplace.git",
  "owner": {
    "name": "kodflow",
    "url": "https://github.com/kodflow"
  },
  "plugins": [
    {"name": "kodflow-workflow", "path": "plugins/kodflow-workflow", "category": "workflow"},
    {"name": "kodflow-review", "path": "plugins/kodflow-review", "category": "review"},
    {"name": "kodflow-devops", "path": "plugins/kodflow-devops", "category": "devops"},
    {"name": "kodflow-shell", "path": "plugins/kodflow-shell", "category": "devops"},
    {"name": "kodflow-specialists", "path": "plugins/kodflow-specialists", "category": "agents"},
    {"name": "kodflow-hooks", "path": "plugins/kodflow-hooks", "category": "hooks"},
    {"name": "kodflow-hud", "path": "plugins/kodflow-hud", "category": "hooks"},
    {"name": "kodflow-ktn", "path": "plugins/kodflow-ktn", "category": "hooks"},
    {"name": "kodflow-gamedev", "path": "plugins/kodflow-gamedev", "category": "agents"}
  ],
  "externals": [
    {
      "name": "coderabbit",
      "description": "CodeRabbit review and autofix skills with its hosted MCP server (OAuth sign-in), pinned to an upstream commit. Opt-in: not part of the default installation.",
      "category": "review",
      "source": {"url": "https://github.com/coderabbitai/skills.git", "sha": "d8e182b7e7c5128e354fd7ff335286cf157cb500"},
      "installByDefault": false,
      "targets": ["claude"]
    }
  ]
}
