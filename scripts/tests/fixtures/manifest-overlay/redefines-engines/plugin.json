{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "overlay-engines",
  "version": "0.0.0",
  "description": "Fixture whose Claude overlay redefines a derived field.",
  "extensions": {
    "io.github.kodflow": {
      "schemaVersion": 1,
      "installByDefault": false,
      "scope": "user",
      "dependencies": [],
      "capabilities": {},
      "targets": {
        "claude": {
          "enabled": true,
          "profile": "native",
          "manifest": {
            "engines": {
              "claude-code": ">=2.1.400"
            },
            "types": "./types/index.d.ts"
          }
        }
      }
    }
  }
}
